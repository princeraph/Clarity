node_modules/
# Local runtime data — tasks, settings, and rolling backups
backend/data/
.env

# Scratch file from scripts/generate-icon.js. It is cleaned up in a finally now,
# but build/ is a committed directory — a stray temp file here blocks `git pull`.
build/_tmp_icon.svg

# Staged backend for electron-builder (tools/preparer-backend.mjs)
.backend-pkg/

# Installer output from `npm run build` (electron-builder) — a build product, never versioned
dist-electron/

# Commit last installed by Update.bat — lets it skip a rebuild when nothing changed
.version-installee
