{
  "name": "clarity",
  "productName": "Clarity",
  "version": "1.2.0",
  "description": "AI-powered personal task manager",
  "author": "Clarity",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend && npm run package",
    "package": "node tools/preparer-backend.mjs && electron-builder",
    "prepare:backend": "node tools/preparer-backend.mjs",
    "generate-icons": "node scripts/generate-icon.js",
    "setup": "npm install && npx install-electron && cd backend && npm install && cd ../frontend && npm install",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.clarity.app",
    "productName": "Clarity",
    "copyright": "Copyright © 2026 Clarity",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*"
    ],
    "afterPack": "tools/verifier-empaquetage.js",
    "extraResources": [
      { "from": ".backend-pkg", "to": "backend", "filter": ["**/*"] },
      { "from": ".backend-pkg/node_modules", "to": "backend/node_modules" },
      { "from": "frontend/dist", "to": "frontend/dist" },
      { "from": "build", "to": "build" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "publish": null
  }
}
